# Environment variables for the Portainer stack. In Portainer: Add stack →
# Environment variables → Advanced mode, and paste these with your values.

# Public addresses, without a trailing slash.
LABELEUR_URL=https://labels.example.com
KEYCLOAK_URL=https://auth.example.com

# Generate each one: openssl rand -hex 32
DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
OIDC_SECRET=change-me

# Who may register: full addresses or whole domains, comma-separated.
# Empty lets everyone with a verified email register.
LABELEUR_REGISTRATION_ALLOWLIST=@example.com

# Mail for email verification and password reset.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=labeleur@example.com
SMTP_USER=labeleur@example.com
SMTP_PASSWORD=change-me
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# An image tag: latest, or a release such as 1.2.0.
LABELEUR_VERSION=latest
