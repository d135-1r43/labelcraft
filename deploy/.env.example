# Public addresses, without a trailing slash.
LABELCRAFT_URL=https://labels.example.com
KEYCLOAK_URL=https://auth.example.com

DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# Shared between Keycloak's client and the app. Generate one: openssl rand -hex 32
OIDC_SECRET=change-me

# Who may register: full addresses or whole domains, comma-separated.
# Empty lets everyone with a verified email register.
LABELCRAFT_REGISTRATION_ALLOWLIST=@example.com, someone@elsewhere.org

# Mail for email verification and password reset.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=labelcraft@example.com
SMTP_USER=labelcraft@example.com
SMTP_PASSWORD=change-me
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# An image tag: latest, or a release such as 1.2.0.
LABELCRAFT_VERSION=latest
