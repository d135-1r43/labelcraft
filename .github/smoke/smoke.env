# deploy/docker-compose.yml on a CI runner: local addresses, no mail.
LABELEUR_URL=http://localhost:8080
KEYCLOAK_URL=http://localhost:8180
DB_PASSWORD=smoke
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_SECRET=smoke-secret
LABELEUR_REGISTRATION_ALLOWLIST=
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_FROM=labeleur@localhost
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
LABELEUR_VERSION=smoke
